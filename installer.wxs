<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?ifndef var.ProductVersion ?>
    <?define ProductVersion = "1.0.0" ?>
  <?endif ?>
  <Product
    Id="*"
    Name="Waybill"
    Language="1033"
    Version="$(var.ProductVersion)"
    Manufacturer="Softdash"
    UpgradeCode="b9190081-b48a-4815-b72b-ff141e36cec4">

    <Package
      InstallerVersion="200"
      Compressed="yes"
      Platform="x64"
      InstallScope="perMachine"
      Description="Waybill Desktop Application" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Waybill is already installed." />

    <Media Id="1" Cabinet="waybill.cab" EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Waybill">
          <Component Id="MainExecutable" Guid="*" Win64="yes">
            <File Id="waybillExe" Name="waybill.exe" Source="build/bin/waybill.exe" KeyPath="yes" />
          </Component>
          <Component Id="AppIconFile" Guid="*" Win64="yes">
            <File Id="AppIcon" Name="icon.ico" Source="installer/icon.ico" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Waybill" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <!-- Start Menu Shortcut with HKLM registry keypath -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="*" Win64="yes">
        <RegistryValue Root="HKLM" Key="Software\Softdash\Waybill" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        <Shortcut Id="startMenuWaybill" Name="Waybill" Description="Launch Waybill"
                  Target="[INSTALLFOLDER]waybill.exe" WorkingDirectory="INSTALLFOLDER"
                   Icon="WaybillIcon" />
        <RemoveFolder Id="RemoveAppFolder" On="uninstall" />
      </Component>
    </DirectoryRef>

    <!-- Desktop Shortcut with HKLM registry keypath -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*" Win64="yes">
        <RegistryValue Root="HKLM" Key="Software\Softdash\Waybill\Desktop" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        <Shortcut Id="desktopWaybill" Name="Waybill" Description="Launch Waybill"
                  Target="[INSTALLFOLDER]waybill.exe" WorkingDirectory="INSTALLFOLDER"
                   Icon="WaybillIcon" />
        <RemoveFolder Id="RemoveDesktopFolder" On="uninstall" />
      </Component>
    </DirectoryRef>

    <Feature Id="Complete" Title="Waybill" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="AppIconFile" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Icon Id="WaybillIcon" SourceFile="installer/icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="WaybillIcon" />
  </Product>
</Wix>
